# Copy to .env and fill in. NEVER commit real values.

# ---------- Django ----------
# Generate: python -c "import secrets;print(secrets.token_urlsafe(60))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
# On Vercel add your backend domain, e.g. .vercel.app
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app

# ---------- Database (Supabase Postgres only; required) ----------
# Local: Session pooler (port 5432).  Vercel: Transaction pooler (port 6543).
# Supabase -> Connect -> pick the pooler URI
DATABASE_URL=postgresql://postgres.<PROJECT_REF>:<DB_PASSWORD>@aws-<N>-<REGION>.pooler.supabase.com:5432/postgres

# ---------- Supabase ----------
SUPABASE_URL=https://<PROJECT_REF>.supabase.co
# Only for legacy HS256 projects; leave empty if the project uses signing keys (JWKS)
SUPABASE_JWT_SECRET=
# Server-only. NEVER put this in the frontend or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------- Media storage ----------
# NOW: Supabase Storage for all media, including videos.
MEDIA_STORAGE=supabase
SUPABASE_STORAGE_BUCKET=media

# ---------- Cloudflare (LATER: switch MEDIA_STORAGE=r2 for streaming) ----------
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_STREAM_API_TOKEN=
CLOUDFLARE_STREAM_CUSTOMER_CODE=

# ---------- CORS / CSRF (frontend origin(s), comma separated, no trailing slash) ----------
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Include the BACKEND's own https origin too if you use /admin on Vercel
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# ---------- Google OAuth (used by Supabase Auth; configured in the Supabase dashboard, not read by Django) ----------
# Supabase -> Authentication -> Sign In / Providers -> Google: paste Client ID + Secret, toggle Enabled.
# Google Cloud Console -> Credentials -> your OAuth client:
#   Authorized JavaScript origins : http://localhost:5173  (+ your Vercel frontend URL)
#   Authorized redirect URIs      : https://<PROJECT_REF>.supabase.co/auth/v1/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
